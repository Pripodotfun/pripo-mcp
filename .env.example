PRIPO_MCP_RPC_URL=https://testnet-rpc.monad.xyz
# Optional default owner for reads. Required for delegated trading.
PRIPO_MCP_OWNER=0x3b2F1773a1B279A1b0b13aD425019C91433693c3
# Optional indexer book API; its snapshots may be historical.
PRIPO_MCP_INDEXER_URL=http://127.0.0.1:3001
# Dedicated operator address enables transaction previews without loading a key.
# PRIPO_MCP_OPERATOR_ADDRESS=0x...
# Only --broadcast reads this key. Never use the deployer or owner's key.
# PRIPO_MCP_OPERATOR_PRIVATE_KEY=0x...
# Keep a persistent, exclusive journal per operator/deployment.
PRIPO_MCP_STATE_PATH=.state/transactions.json
